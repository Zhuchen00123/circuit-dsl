# RC low-pass: the worked example from the language specification.
#
#   op    steady state before the step
#   ac    H(jw) = 1 / (1 + jwRC), corner at 1/(2*pi*R*C) = 1.5915 kHz
#   tran  step response v(t) = 1 - exp(-t/tau), tau = R*C = 100 us
#
# Transient stimulus, measured this round on this exact file with
#   cdsl run examples/rc_filter.cdsl --experiment response \
#     --out target\round2-recon\r2\rc-filter --format csv      (exit 0)
# The declared `rise: 1.ns` is delivered, not widened:
#
# * The adapter picks the engine's print step as
#   min(span/1000, min(rise, fall, period)) = min(500 ns, 1 ns) = 1 ns, so the
#   engine's `tr.unwrap_or(tstep).max(tstep)` clamp (waveform.rs:37) cannot
#   bind. v(vin) reaches 1 V at t = 1 ns, and the result carries
#   tran.solver_step = 1 ns / tran.waveform_bound = 1 ns.
# * The 1019 samples of response.tran1.csv match the matched 1 ns-ramp analytic
#   reference to max |err| = 7.916906e-7 V.
# * Against the ideal step `1 - exp(-t/tau)` the same samples differ by at most
#   4.921844e-6 V (at t = 1 ns). That residual is the physics of a 1 ns ramp,
#   not solver error: C(T) = 1 - (tau/T)*(exp(T/tau) - 1) = -5.000007e-6 V for
#   T = 1 ns. A checker comparing against the ideal step must allow for it;
#   this round's regressions use the matched finite-ramp reference instead
#   (crates/circuit-backend/tests/transient_reference_regression.rs).
#
# `max_step` bounds the solver's *internal* step and `output_interval` selects
# the *output* sampling; they are independent. No `output_interval:` is given
# here, so the exported trace is the solver's own (non-uniform) time grid; an
# `output_interval:` would resample that trace after the solve without changing
# the stimulus or the `avg`/`rms`/`max`/`min` measurements, which are computed
# on the raw grid (docs/language.md §5.3).

circuit :rc_filter do
  param :r, default: 1.kohm
  param :c, default: 100.nF

  node :vin, :vout

  voltage_source :input, p: :vin, n: :gnd,
    dc: 0.V,
    ac: 1.V,
    waveform: pulse(low: 0.V, high: 1.V,
                    delay: 0.s, rise: 1.ns,
                    fall: 1.ns, width: 5.ms,
                    period: 10.ms)

  resistor :r1, p: :vin, n: :vout, value: r
  capacitor :c1, p: :vout, n: :gnd, value: c
end

experiment :response, circuit: :rc_filter do
  op
  ac from: 10.Hz, to: 10.MHz, points_per_decade: 20
  tran stop: 500.us, max_step: 500.ns

  save v(:vin), v(:vout), i(:input), i(:r1)
  measure :vfinal, max: v(:vout)
  measure :vavg, avg: v(:vout)
  measure :vrms, rms: v(:vout)
end
